{
  "name": "jsm-hq",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && tsc --noEmit -p server && vite build",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p server",
    "preview": "vite preview",
    "postinstall": "node scripts/fix-node-pty.mjs",
    "dev:hq": "concurrently -k -n hq,ui -c magenta,cyan \"tsx watch server/main.ts --dev\" \"vite\"",
    "hq": "vite build --logLevel warn && tsx server/main.ts"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "framer-motion": "^11.18.2",
    "node-pty": "^1.1.0",
    "pixi.js": "^8.22.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ws": "^8.22.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "vite": "^6.4.4"
  }
}
